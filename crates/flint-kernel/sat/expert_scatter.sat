kernel expert_scatter [workgroup(256, 1, 1)] (acc: buf<f32>, src: buf<f32>, ids: buf<u32>, weights: buf<f32>, HIDDEN: u32, COUNT: u32) {
    if gid.x < COUNT * HIDDEN {
        let r = gid.x / HIDDEN;
        let c = gid.x % HIDDEN;
        acc[ids[r] * HIDDEN + c] = acc[ids[r] * HIDDEN + c] + weights[r] * src[gid.x];
    }
}
