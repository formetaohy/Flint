kernel embed [workgroup(256, 1, 1)]
    (ids: buf<u32>, table: buf<u32>, scales: buf<f32>, y: buf<f32>,
     M: u32, DIM: u32, SCALE: f32, WDTYPE: u32, GROUP: u32)
{
    if gid.x < M * DIM {
        let row = ids[gid.x / DIM];
        let d = gid.x % DIM;
        if WDTYPE == 1 {
            let word = table[row * (DIM / 4) + d / 4];
            let byte = (word >> ((d % 4) * 8)) & 255;
            let v = (((byte << 24) as i32 >> 24) as f32) * scales[(d / GROUP) * M + row];
            y[gid.x] = v * SCALE;
        } else {
            let p = table[row * (DIM / 2) + d / 2];
            if d % 2 == 0 {
                y[gid.x] = bitcast_f32((p & 65535) << 16) * SCALE;
            } else {
                y[gid.x] = bitcast_f32((p >> 16) << 16) * SCALE;
            }
        }
    }
}
