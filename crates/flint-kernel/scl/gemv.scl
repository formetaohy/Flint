@workgroup_size(256, 1, 1)
kernel gemv
    (@binding(0) x: buf<f32>, @binding(1) w: buf<u32>, @binding(2) scales: buf<f32>, @binding(3) y: buf<f32>,
     N: u32, K: u32, WDTYPE: u32, GROUP: u32, SEGS: u32, ACC: u32)
{
    let col = group_id().x * 256 + local_id().x;
    let seg = group_id().y;
    let kb_total = (K / 16) / SEGS;
    let kb_lo = seg * kb_total;
    let mut acc = 0.0;
    if col < N {
        for it in 0..kb_total {
            let kb0 = kb_lo + it;
            let xb = kb0 * 16;
            let x0 = x[xb];
            let x1 = x[xb + 1];
            let x2 = x[xb + 2];
            let x3 = x[xb + 3];
            let x4 = x[xb + 4];
            let x5 = x[xb + 5];
            let x6 = x[xb + 6];
            let x7 = x[xb + 7];
            let x8 = x[xb + 8];
            let x9 = x[xb + 9];
            let x10 = x[xb + 10];
            let x11 = x[xb + 11];
            let x12 = x[xb + 12];
            let x13 = x[xb + 13];
            let x14 = x[xb + 14];
            let x15 = x[xb + 15];
            if WDTYPE == 1 {
                let wb = (kb0 * N + col) * 4;
                let sc = scales[(kb0 / (GROUP / 16)) * N + col];
                let wb4 = (kb0 * N + col) * 4;
                let q0 = w[wb4];
                let q1 = w[wb4 + 1];
                let q2 = w[wb4 + 2];
                let q3 = w[wb4 + 3];
                let w00 = (((q0 & 255) << 24) as i32 >> 24i) as f32;
                let w01 = ((((q0 & 65280) << 16) as i32) >> 24i) as f32;
                let w02 = ((((q0 & 16711680) << 8) as i32) >> 24i) as f32;
                let w03 = (((q0 >> 24) << 24) as i32 >> 24i) as f32;
                let w10 = (((q1 & 255) << 24) as i32 >> 24i) as f32;
                let w11 = ((((q1 & 65280) << 16) as i32) >> 24i) as f32;
                let w12 = ((((q1 & 16711680) << 8) as i32) >> 24i) as f32;
                let w13 = (((q1 >> 24) << 24) as i32 >> 24i) as f32;
                let w20 = (((q2 & 255) << 24) as i32 >> 24i) as f32;
                let w21 = ((((q2 & 65280) << 16) as i32) >> 24i) as f32;
                let w22 = ((((q2 & 16711680) << 8) as i32) >> 24i) as f32;
                let w23 = (((q2 >> 24) << 24) as i32 >> 24i) as f32;
                let w30 = (((q3 & 255) << 24) as i32 >> 24i) as f32;
                let w31 = ((((q3 & 65280) << 16) as i32) >> 24i) as f32;
                let w32 = ((((q3 & 16711680) << 8) as i32) >> 24i) as f32;
                let w33 = (((q3 >> 24) << 24) as i32 >> 24i) as f32;
                let mut dotp = x0 * w00 + x1 * w01 + x2 * w02 + x3 * w03;
                dotp = dotp + x4 * w10 + x5 * w11 + x6 * w12 + x7 * w13;
                dotp = dotp + x8 * w20 + x9 * w21 + x10 * w22 + x11 * w23;
                dotp = dotp + x12 * w30 + x13 * w31 + x14 * w32 + x15 * w33;
                acc = acc + dotp * sc;
            } else {
                let wb = (col * (K / 8) + kb0 * 2) * 4;
                let a0 = w[wb];
                let a1 = w[wb + 1];
                let a2 = w[wb + 2];
                let a3 = w[wb + 3];
                let a4 = w[wb + 4];
                let a5 = w[wb + 5];
                let a6 = w[wb + 6];
                let a7 = w[wb + 7];
                let w00 = bitcast_f32((a0 & 65535) << 16);
                let w01 = bitcast_f32((a0 >> 16) << 16);
                let w02 = bitcast_f32((a1 & 65535) << 16);
                let w03 = bitcast_f32((a1 >> 16) << 16);
                let w10 = bitcast_f32((a2 & 65535) << 16);
                let w11 = bitcast_f32((a2 >> 16) << 16);
                let w12 = bitcast_f32((a3 & 65535) << 16);
                let w13 = bitcast_f32((a3 >> 16) << 16);
                let w20 = bitcast_f32((a4 & 65535) << 16);
                let w21 = bitcast_f32((a4 >> 16) << 16);
                let w22 = bitcast_f32((a5 & 65535) << 16);
                let w23 = bitcast_f32((a5 >> 16) << 16);
                let w30 = bitcast_f32((a6 & 65535) << 16);
                let w31 = bitcast_f32((a6 >> 16) << 16);
                let w32 = bitcast_f32((a7 & 65535) << 16);
                let w33 = bitcast_f32((a7 >> 16) << 16);
                let mut dotp = x0 * w00 + x1 * w01 + x2 * w02 + x3 * w03;
                dotp = dotp + x4 * w10 + x5 * w11 + x6 * w12 + x7 * w13;
                dotp = dotp + x8 * w20 + x9 * w21 + x10 * w22 + x11 * w23;
                dotp = dotp + x12 * w30 + x13 * w31 + x14 * w32 + x15 * w33;
                acc = acc + dotp;
            }
        }
        if SEGS == 1 {
            y[col] = acc + ACC as f32 * y[col];
        } else {
            y[seg * N + col] = acc;
        }
    }
}
