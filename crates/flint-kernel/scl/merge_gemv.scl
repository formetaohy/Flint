@workgroup_size(256, 1, 1)
kernel merge_gemv
    (@binding(0) partial: buf<f32>, @binding(1) y: buf<f32>, N: u32, SEGS: u32, ACC: u32)
{
    let col = group_id().x * 256 + local_id().x;
    if col < N {
        let mut s = 0.0;
        for i in 0..SEGS {
            s = s + partial[i * N + col];
        }
        y[col] = s + ACC as f32 * y[col];
    }
}
