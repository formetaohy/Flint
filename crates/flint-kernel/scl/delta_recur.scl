@workgroup_size(128, 1, 1)
kernel delta_recur
    (@binding(0) q_in: buf<f32>, @binding(1) k_in: buf<f32>, @binding(2) v_in: buf<f32>, @binding(3) beta: buf<f32>, @binding(4) g: buf<f32>, @binding(5) state: buf<f32>, @binding(6) out: buf<f32>,
     HEADS: u32, K_DIM: u32, V_DIM: u32)
{
    let mut kk: threadgroup<[f32; 128]>;
    let mut qq: threadgroup<[f32; 128]>;
    let mut red: threadgroup<[f32; 128]>;
    let h = group_id().x;
    let t = local_id().x;
    if t < K_DIM {
        kk[t] = k_in[h * K_DIM + t];
        qq[t] = q_in[h * K_DIM + t];
    } else {
        kk[t] = 0.0;
        qq[t] = 0.0;
    }
    barrier();
    red[t] = kk[t] * kk[t];
    barrier();
    let mut size = 64;
    loop {
        if size == 0 {
            break;
        }
        if t < size {
            red[t] = red[t] + red[t + size];
        }
        barrier();
        size = size / 2;
    }
    let k_scale = rsqrt(red[0] + 1.0e-6);
    barrier();
    red[t] = qq[t] * qq[t];
    barrier();
    size = 64;
    loop {
        if size == 0 {
            break;
        }
        if t < size {
            red[t] = red[t] + red[t + size];
        }
        barrier();
        size = size / 2;
    }
    let q_scale = rsqrt(red[0] + 1.0e-6);
    kk[t] = kk[t] * k_scale;
    qq[t] = qq[t] * q_scale / sqrt(K_DIM as f32);
    barrier();
    if t < V_DIM {
        let decay = exp(g[h]);
        let bt = beta[h];
        let base = h * K_DIM * V_DIM;
        let mut kv_mem = 0.0;
        for k in 0..K_DIM {
            kv_mem = kv_mem + state[base + k * V_DIM + t] * decay * kk[k];
        }
        let delta = (v_in[h * V_DIM + t] - kv_mem) * bt;
        let mut acc = 0.0;
        for k in 0..K_DIM {
            let s = state[base + k * V_DIM + t] * decay + kk[k] * delta;
            state[base + k * V_DIM + t] = s;
            acc = acc + s * qq[k];
        }
        out[h * V_DIM + t] = acc;
    }
}
