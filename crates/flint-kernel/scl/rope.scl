@workgroup_size(256, 1, 1)
kernel rope
    (@binding(0) cos_tbl: buf<f32>, @binding(1) sin_tbl: buf<f32>, @binding(2) x: buf<f32>, @binding(3) args: buf<u32>,
     HEADS: u32, HEAD_DIM: u32, ROT: u32, COS_STRIDE: u32)
{
    let mut tile: threadgroup<[f32; 256]>;
    let head_base = (group_id().x * HEADS + group_id().y) * HEAD_DIM;
    if local_id().x < HEAD_DIM {
        tile[local_id().x] = x[head_base + local_id().x];
    }
    barrier();
    if local_id().x < ROT {
        let half = ROT / 2;
        let c = cos_tbl[(args[0] + group_id().x) * COS_STRIDE + local_id().x % half];
        let s = sin_tbl[(args[0] + group_id().x) * COS_STRIDE + local_id().x % half];
        if local_id().x < half {
            x[head_base + local_id().x] = tile[local_id().x] * c - tile[local_id().x + half] * s;
        } else {
            x[head_base + local_id().x] = tile[local_id().x] * c + tile[local_id().x - half] * s;
        }
    }
}
