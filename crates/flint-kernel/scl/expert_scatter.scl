@workgroup_size(256, 1, 1)
kernel expert_scatter (@binding(0) acc: buf<f32>, @binding(1) src: buf<f32>, @binding(2) ids: buf<u32>, @binding(3) weights: buf<f32>, HIDDEN: u32, COUNT: u32) {
    if global_id().x < COUNT * HIDDEN {
        let r = global_id().x / HIDDEN;
        let c = global_id().x % HIDDEN;
        acc[ids[r] * HIDDEN + c] = acc[ids[r] * HIDDEN + c] + weights[r] * src[global_id().x];
    }
}
