fn load_x(x: buf<f32>, row: u32, col: u32, K: u32, M: u32) -> f32 {
    if row < M {
        return x[row * K + col];
    }
    return 0.0;
}

fn decode_w(w: buf<u32>, scales: buf<f32>, n0: u32, kk: u32, k_base: u32,
            N: u32, K: u32, GROUP: u32, WDTYPE: u32) -> f32 {
    if n0 >= N {
        return 0.0;
    }
    if WDTYPE == 1 {
        let kb = (k_base + kk) / 16;
        let word = w[(kb * N + n0) * 4 + (kk % 16) / 4];
        let byte = (word >> (((kk % 16) % 4) * 8)) & 255;
        let sc = scales[(kb / (GROUP / 16)) * N + n0];
        return (((byte << 24) as i32 >> 24i) as f32) * sc;
    } else {
        let word = w[n0 * (K / 2) + (k_base + kk) / 2];
        if kk % 2 == 0 {
            return bitcast_f32((word & 65535) << 16);
        }
        return bitcast_f32((word >> 16) << 16);
    }
}

@workgroup_size(256, 1, 1)
kernel gemm
    (@binding(0) x: buf<f32>, @binding(1) w: buf<u32>, @binding(2) scales: buf<f32>, @binding(3) y: buf<f32>,
     N: u32, K: u32, M: u32, SEGS: u32, WDTYPE: u32, GROUP: u32,
     ACC: u32, Y_STRIDE: u32, Y_OFF: u32)
{
    const TM: u32 = 32;
    const TN: u32 = 32;
    const BK: u32 = 32;
    const PAD: u32 = 33;
    let mut xs: threadgroup<[f32; 2112]>;
    let mut wf: threadgroup<[f32; 2112]>;
    let seg = group_id().z;
    let m0 = group_id().y * TM;
    let n0 = group_id().x * TN;
    let ks = K / SEGS;
    let k_lo = seg * ks;
    let steps = ks / BK;
    let ln = local_id().x;
    let r0 = (ln / 16) * 2;
    let c0 = (ln % 16) * 2;
    let mut acc0 = 0.0;
    let mut acc1 = 0.0;
    let mut acc2 = 0.0;
    let mut acc3 = 0.0;
    for i in 0..4 {
        let idx = ln + i * 256;
        xs[(idx / 32) * PAD + idx % 32] = load_x(x, m0 + idx / 32, k_lo + idx % 32, K, M);
    }
    for i in 0..4 {
        let idx = ln + i * 256;
        wf[(idx / 32) * PAD + idx % 32] =
            decode_w(w, scales, n0 + idx / 32, idx % 32, k_lo, N, K, GROUP, WDTYPE);
    }
    barrier();
    for it in 0..steps {
        let phase = it % 2;
        for s in 0..8 {
            let xb = phase * 1056 + r0 * PAD + s * 4;
            let wb = phase * 1056 + c0 * PAD + s * 4;
            let x0 = xs[xb];
            let x1 = xs[xb + 1];
            let x2 = xs[xb + 2];
            let x3 = xs[xb + 3];
            let x4 = xs[xb + PAD];
            let x5 = xs[xb + PAD + 1];
            let x6 = xs[xb + PAD + 2];
            let x7 = xs[xb + PAD + 3];
            let w0 = wf[wb];
            let w1 = wf[wb + 1];
            let w2 = wf[wb + 2];
            let w3 = wf[wb + 3];
            let w4 = wf[wb + PAD];
            let w5 = wf[wb + PAD + 1];
            let w6 = wf[wb + PAD + 2];
            let w7 = wf[wb + PAD + 3];
            acc0 = acc0 + x0 * w0 + x1 * w1 + x2 * w2 + x3 * w3;
            acc1 = acc1 + x0 * w4 + x1 * w5 + x2 * w6 + x3 * w7;
            acc2 = acc2 + x4 * w0 + x5 * w1 + x6 * w2 + x7 * w3;
            acc3 = acc3 + x4 * w4 + x5 * w5 + x6 * w6 + x7 * w7;
        }
        if it + 1 < steps {
            let p1 = (1 - phase) * 1056;
            let k1 = k_lo + (it + 1) * BK;
            for i in 0..4 {
                let idx = ln + i * 256;
                xs[p1 + (idx / 32) * PAD + idx % 32] =
                    load_x(x, m0 + idx / 32, k1 + idx % 32, K, M);
            }
            for i in 0..4 {
                let idx = ln + i * 256;
                wf[p1 + (idx / 32) * PAD + idx % 32] =
                    decode_w(w, scales, n0 + idx / 32, idx % 32, k1, N, K, GROUP, WDTYPE);
            }
            barrier();
        }
        barrier();
    }
    let yoff = SEGS > 1 ? seg * (M * Y_STRIDE) : 0;
    if m0 + r0 < M {
        if n0 + c0 < N {
            y[yoff + (m0 + r0) * Y_STRIDE + Y_OFF + n0 + c0] = acc0 + ACC as f32 * y[yoff + (m0 + r0) * Y_STRIDE + Y_OFF + n0 + c0];
        }
        if n0 + c0 + 1 < N {
            y[yoff + (m0 + r0) * Y_STRIDE + Y_OFF + n0 + c0 + 1] = acc1 + ACC as f32 * y[yoff + (m0 + r0) * Y_STRIDE + Y_OFF + n0 + c0 + 1];
        }
    }
    if m0 + r0 + 1 < M {
        if n0 + c0 < N {
            y[yoff + (m0 + r0 + 1) * Y_STRIDE + Y_OFF + n0 + c0] = acc2 + ACC as f32 * y[yoff + (m0 + r0 + 1) * Y_STRIDE + Y_OFF + n0 + c0];
        }
        if n0 + c0 + 1 < N {
            y[yoff + (m0 + r0 + 1) * Y_STRIDE + Y_OFF + n0 + c0 + 1] = acc3 + ACC as f32 * y[yoff + (m0 + r0 + 1) * Y_STRIDE + Y_OFF + n0 + c0 + 1];
        }
    }
}
