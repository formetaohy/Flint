@workgroup_size(256, 1, 1)
kernel delta_gate
    (@binding(0) b_in: buf<f32>, @binding(1) a_in: buf<f32>, @binding(2) a_log: buf<f32>, @binding(3) dt_bias: buf<f32>, @binding(4) beta: buf<f32>, @binding(5) g: buf<f32>,
     HEADS: u32, ROW_T: u32)
{
    if global_id().x < HEADS {
        let h = global_id().x;
        let row = ROW_T * HEADS;
        beta[h] = 1.0 / (1.0 + exp(-b_in[row + h]));
        let x = a_in[row + h] + dt_bias[h];
        let sp = log(1.0 + exp(x));
        g[h] = -exp(a_log[h]) * sp;
    }
}
