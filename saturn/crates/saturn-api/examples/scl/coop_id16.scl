@workgroup_size(16, 16, 1)
kernel id16 (@binding(0) src: buf<f16>, @binding(1) dst: buf<f32>) {
    let mut tile: threadgroup<[f16; 16 * 16]>;
    tile[local_id().y * 16 + local_id().x] = src[local_id().y * 16 + local_id().x];
    barrier();
    let a = coop_load_a(tile, 16, true);
    let b = coop_load_b(tile, 16, true);
    let mut acc: matrix<f32> = coop_zero();
    acc = coop_mul_add(a, b, acc);
    coop_store(dst, acc, 16, true);
}
